# ---------------------------------------------------------------------------
# RUSAFAH public website — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres connection string (docker-compose exposes 5434 locally).
DATABASE_URL=postgres://rusafah:rusafah@localhost:5434/rusafah_web

# Separate database used by the integration test suite (created by `pnpm db:test:prepare`).
TEST_DATABASE_URL=postgres://rusafah:rusafah@localhost:5434/rusafah_web_test

# Canonical public origin, used for metadata, sitemap and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP endpoint used by the notification worker to deliver lead alerts.
# Development: Mailpit from docker-compose. Production: the company mail provider.
SMTP_URL=smtp://localhost:1026
SMTP_FROM="موقع رُصافة <no-reply@rusafahre.com>"

# Inbox that receives new-lead alerts (contact form, interest, visit bookings).
LEADS_NOTIFY_EMAIL=leads@rusafahre.com

# Secret salt used to hash visitor IP addresses for rate limiting. Raw IPs are never stored.
RATE_LIMIT_SALT=change-me-in-production

# Enable only after SMTP is configured. Leads are stored even while alerts are disabled.
RUN_NOTIFICATION_WORKER=false

# Seals the admin (/admin) session cookie. 32+ random characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# Where uploaded project/site images are written; served from the same path under /.
# Local disk today (see modules/media/storage-port.ts) — swap for an S3-compatible
# adapter once hosting is decided (platform D-11).
MEDIA_UPLOAD_DIR=public/uploads

# CRM integration (modules/integrations/crm — see docs/runbooks/crm-integration.md).
# "none" (default): no CRM sync is attempted, nothing is queued.
# "webhook": leads are POSTed as JSON to CRM_WEBHOOK_URL (works unmodified against
# a PostgREST endpoint such as a Supabase project's `/rest/v1/<table>`, or any other
# webhook receiver).
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
CRM_API_KEY=
