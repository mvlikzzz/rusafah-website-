{
  "name": "@rusafah/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:logical",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed/index.ts",
    "db:reset": "tsx db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:test:prepare": "tsx db/test-prepare.ts",
    "setup": "pnpm db:migrate && pnpm db:seed",
    "setup:local": "docker compose up -d --wait && pnpm setup",
    "test": "vitest run --project unit",
    "test:integration": "pnpm db:test:prepare && vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "map:assets": "node scripts/copy-map-assets.mjs",
    "report:bundle": "node scripts/report-bundle.mjs",
    "predev": "node scripts/copy-map-assets.mjs",
    "prebuild": "node scripts/copy-map-assets.mjs",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:logical": "node scripts/check-logical-props.mjs",
    "db:rollback": "tsx db/rollback.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "@protomaps/basemaps": "^5.7.2",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^6.9.0",
    "next": "16.4.2",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "pg-boss": "^12.31.0",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "simple-icons": "^16.30.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "vite": "7.3.6"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  }
}
